# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/haveniq
# Postgres connection-pool size per process. Default 20. Raise for a launch
# spike WITHOUT a redeploy — but keep PG_POOL_MAX × (replicas) safely under the
# database's max_connections (leave headroom for migrations + psql + superuser).
PG_POOL_MAX=20

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=30d

# ── Email (SendGrid) ──────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@haveniq.org
FROM_NAME=HavenIQ

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:8081

# ── Load testing (STAGING ONLY) ───────────────────────────────────────────
# Set to "true" ONLY on the staging service to disable ALL rate limiters
# (global + per-IP + per-email auth + write limiters) so a k6 arrival-rate ramp
# isn't throttled. Boot logs a loud banner when set. NEVER set in production —
# production keeps its limiters on by leaving this unset.
# RATE_LIMIT_DISABLED=true

# ── File Storage (optional — Cloudinary for profile photos) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI (Anthropic — personality derivation) ──────────────────────────────
# Used by services/personality.js to turn quiz answers into an OCEAN profile
# at quiz submission. If unset, the app falls back to a deterministic profile
# (no crash). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=
