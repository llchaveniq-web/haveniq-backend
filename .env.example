# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/haveniq

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=30d

# ── Email (SendGrid) ──────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@haveniq.com
FROM_NAME=HavenIQ

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:8081

# ── File Storage (optional — Cloudinary for profile photos) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI (Anthropic — personality derivation) ──────────────────────────────
# Used by services/personality.js to turn quiz answers into an OCEAN profile
# at quiz submission. If unset, the app falls back to a deterministic profile
# (no crash). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=
